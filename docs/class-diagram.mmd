classDiagram
    direction TB

    class Game {
        +int GOLD_TARGET$
        -Terminal terminal
        -ChannelMap map
        -PlayerShip player
        -Encounter encounter
        -Random random
        -boolean running
        +Game(Terminal terminal, ChannelMap map, Random random)
        +main(String[] args)$ void
        +run() void
        +execute(Command command) String
        +mode() GameMode
        +isRunning() boolean
        +getPlayer() PlayerShip
        +getEncounter() Encounter
    }

    class Terminal {
        -Scanner in
        -PrintStream out
        +Terminal(Scanner in, PrintStream out)
        +readLine() String
        +confirm(String question) boolean
        +println(String text) void
    }

    class Command {
        -Verb verb
        -String argument
        +Command(Verb verb, String argument)
        +parse(String line)$ Command
        +parseAmount(String text)$ int
        +getVerb() Verb
        +getArgument() String
        +getWord(int index) String
        +toString() String
    }

    class Verb {
        <<enumeration>>
        LOOK
        STATUS
        SAIL
        REPAIR
        HIRE
        BUY
        BONUS
        FIGHT
        FLEE
        RETIRE
        HELP
        QUIT
        -String usage
        +getUsage() String
    }

    class GameMode {
        <<enumeration>>
        IN_PORT
        AT_SEA
        IN_ENCOUNTER
    }

    class InvalidCommandException {
        +InvalidCommandException(String message)
    }

    class ChannelMap {
        -ArrayList~Location~ stops
        -Port home
        +standard()$ ChannelMap
        +add(Location stop) void
        +connect(String keyA, String keyB) void
        +find(String name) Location
        +resolveMove(Location from, String name) Location
        +getHome() Port
    }

    class Location {
        -String key
        -String name
        -LocationKind kind
        -ArrayList~Location~ neighbours
        +Location(String key, String name, LocationKind kind)
        +connect(Location other) void
        +isNextTo(Location other) boolean
        +getNeighbours() List~Location~
        +getKey() String
        +getName() String
        +getKind() LocationKind
        +describe() String
    }

    class Port {
        +int REPAIR_PRICE$
        +int HIRE_PRICE$
        +int RUM_PRICE$
        +int UPGRADE_PRICE$
        -String owner
        +Port(String key, String name, String owner)
        +getOwner() String
        +rumPrice() int
        +sellRepair(PlayerShip ship, int points) int
        +sellCrew(PlayerShip ship, int men) int
        +sellRum(PlayerShip ship, int bottles) int
        +sellUpgrade(PlayerShip ship, String item) int
