        +allTemplates() String
        +parseCount(String text)$ int
    }

    class Command {
        -String verb
        -String argument
        +Command(String verb, String argument)
        +getVerb() String
        +getArgument() String
        +getWord(int i) String
    }

    class ChannelMap {
        -int SEA_LANE_CHANCE$
        -int HIGH_SEAS_CHANCE$
        -HashMap~String, Location~ stops
        +ChannelMap()
        +find(String name) Location
        +getHome() Port
    }

