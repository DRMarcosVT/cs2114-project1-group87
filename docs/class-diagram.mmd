        -PlayerShip player
        -Encounter encounter
        -Random random
        -boolean running
        -boolean confirmingQuit
        +Game(Scanner in, ChannelMap map, Random random)
        +main(String[] args)$ void
        +run() void
        -show(String reply)$ void
        +dispatch(Command command) String
